use runduration;

fn main() {
    let parents = [-1, 0, 0, 2];
    let durations = [1, 3, 2, 5];
    let result = runduration_path(parents, durations);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
